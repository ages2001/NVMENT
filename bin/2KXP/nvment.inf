; nvment.inf
; Windows 2000 / XP / Server 2003 (x86, Alpha) and XP x64 / Server 2003 x64 (amd64)
; NVMe Storage Controller Driver Installation File
;
; nvme2k by DominBear (Dominik Behr), https://github.com/techomancer/nvme2k
; NVMENT by ages2001, based on nvme2k
; Copyright (c) 2025-2026 Dominik Behr, 2026 ages2001

[Version]
Signature="$Windows NT$"
Class=SCSIAdapter
ClassGUID={4D36E97B-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderString%
DriverVer=10/19/2026,3.1.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12  ; DIRID_DRIVERS
NVMe_PageFiles = 11  ; DIRID_SYSTEM (Device Manager page)

;-------------------------------------------------------------------------------
;                    Source disks
;-------------------------------------------------------------------------------

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksNames.x86]
1 = %DiskName%,,,\i386

[SourceDisksNames.alpha]
1 = %DiskName%,,,\alpha

[SourceDisksNames.amd64]
1 = %DiskName%,,,\amd64

[SourceDisksFiles]
nvment.sys=1

[SourceDisksFiles.x86]
nvment.sys=1
nvmentpp.dll=1

[SourceDisksFiles.alpha]
nvment.sys=1

[SourceDisksFiles.amd64]
nvment.sys=1
nvmentpp.dll=1

;-------------------------------------------------------------------------------
;                    Models
;-------------------------------------------------------------------------------

[Manufacturer]
%VendorString%=NVMe_Models,NTx86,NTamd64

[NVMe_Models]
%NVMe.DeviceDesc% = NVMe_Inst, PCI\CC_010802

[NVMe_Models.NTx86]
%NVMe.DeviceDesc% = NVMe_Inst, PCI\CC_010802

[NVMe_Models.NTamd64]
%NVMe.DeviceDesc.amd64% = NVMe_Inst, PCI\CC_010802

;-------------------------------------------------------------------------------
;                    Install NVMENT Service
;-------------------------------------------------------------------------------

[NVMe_Inst]
CopyFiles = NVMe_CopyFiles

[NVMe_Inst.Services]
AddService = NVMENT, %SPSVCINST_ASSOCSERVICE%, NVMe_Service_Inst, Miniport_EventLog_Inst

; x86 and x64: also the Device Manager page (Namespaces); none for Alpha
[NVMe_Inst.NTx86]
CopyFiles = NVMe_CopyFiles, NVMe_PageFiles
AddReg    = NVMe_PageReg

[NVMe_Inst.NTx86.Services]
AddService = NVMENT, %SPSVCINST_ASSOCSERVICE%, NVMe_Service_Inst, Miniport_EventLog_Inst

[NVMe_Inst.NTamd64]
CopyFiles = NVMe_CopyFiles, NVMe_PageFiles
AddReg    = NVMe_PageReg

[NVMe_Inst.NTamd64.Services]
AddService = NVMENT, %SPSVCINST_ASSOCSERVICE%, NVMe_Service_Inst, Miniport_EventLog_Inst

[NVMe_Service_Inst]
ServiceType    = %SERVICE_KERNEL_DRIVER%
StartType      = %SERVICE_BOOT_START%
ErrorControl   = %SERVICE_ERROR_NORMAL%
ServiceBinary  = %12%\nvment.sys
LoadOrderGroup = SCSI Miniport
AddReg         = NVMe_AddReg

[NVMe_CopyFiles]
nvment.sys

[NVMe_PageFiles]
nvmentpp.dll

[NVMe_PageReg]
HKR,,EnumPropPages32,,"nvmentpp.dll,PortPageProvider"

[NVMe_AddReg]
HKR, "Parameters\PnpInterface", "5", %REG_DWORD%, 0x00000001
HKR, "Parameters\Device", "MaximumSGList", %REG_DWORD%, 0x000000FF
HKR, "Parameters\Device", "NumberOfRequests", %REG_DWORD%, 0x00000020

[Miniport_EventLog_Inst]
AddReg = Miniport_EventLog_AddReg

[Miniport_EventLog_AddReg]
HKR,,EventMessageFile,%REG_EXPAND_SZ%,"%%SystemRoot%%\System32\IoLogMsg.dll"
HKR,,TypesSupported,%REG_DWORD%,7

[Strings]
ProviderString        = "ages2001"
VendorString          = "Standard NVM Express Controller"
NVMe.DeviceDesc       = "NVMENT NVMe Storage Controller"
NVMe.DeviceDesc.amd64 = "NVMENT NVMe Storage Controller (x64)"
DiskName              = "NVMENT NVMe Driver Disk"

; Service install flags
SPSVCINST_ASSOCSERVICE = 0x00000002

; Service Type
SERVICE_KERNEL_DRIVER  = 1

; Service Start Type
SERVICE_BOOT_START     = 0
SERVICE_SYSTEM_START   = 1
SERVICE_AUTO_START     = 2
SERVICE_DEMAND_START   = 3
SERVICE_DISABLED       = 4

; Service Error Control
SERVICE_ERROR_IGNORE   = 0
SERVICE_ERROR_NORMAL   = 1
SERVICE_ERROR_SEVERE   = 2
SERVICE_ERROR_CRITICAL = 3

; Registry types
REG_SZ         = 0x00000000
REG_MULTI_SZ   = 0x00010000
REG_EXPAND_SZ  = 0x00020000
REG_BINARY     = 0x00000001
REG_DWORD      = 0x00010001
REG_NONE       = 0x00020001
